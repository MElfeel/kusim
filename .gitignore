# Everything is ignored except the paths listed below.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/pyproject.toml
!/uv.lock
!/readme.md
!/LICENSE
!/LICENSE.*
!/CITATION.cff
!/CLAUDE.md
!/AGENTS.md
!/src/
!/tests/
!/docs/
!/examples/
