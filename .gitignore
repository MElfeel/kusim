!/eclipse_comparison/eclipse/*.DATA
!/eclipse_comparison/eclipse/*.UNSMRY
!/eclipse_comparison/eclipse/*.SMSPEC
!/eclipse_comparison/eclipse_runs/
/eclipse_comparison/eclipse_runs/*
!/eclipse_comparison/eclipse_runs/bonus_case/
/eclipse_comparison/eclipse_runs/bonus_case/*
