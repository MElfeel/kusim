/eclipse_comparison/*
!/eclipse_comparison/README.md
!/eclipse_comparison/findings.md
!/eclipse_comparison/investigation_upstream.py
!/eclipse_comparison/kusim_vs_eclipse.ipynb
!/eclipse_comparison/eclipse/
